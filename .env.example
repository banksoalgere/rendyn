NODE_ENV=development
PORT=8787

# Public origins used in MCP discovery and returned preview URLs.
PUBLIC_BASE_URL=http://localhost:8787
PREVIEW_BASE_URL=http://localhost:3100
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Auth is the OAuth 2.1 authorization server. Enable OAuth Server,
# dynamic client registration, and an asymmetric JWT signing key in Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
MCP_REQUIRED_SCOPES=openid

# At least 32 random bytes. Used to sign the anonymous browser identity cookie.
ANONYMOUS_COOKIE_SECRET=

# Hosted embeddings. The provider performs tokenization and vectorization.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Development-only escape hatch for local MCP protocol tests. Never enable in
# a deployed environment. Tokens must be `dev:<uuid>`.
ALLOW_INSECURE_DEV_AUTH=false
