{
  "name": "designmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @designmcp/api --filter @designmcp/preview dev",
    "dev:api": "pnpm --filter @designmcp/api dev",
    "dev:preview": "pnpm --filter @designmcp/preview dev",
    "start:api": "pnpm --filter @designmcp/api start",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "catalog:embed": "tsx scripts/embed-catalog.ts",
    "catalog:screenshots": "tsx scripts/capture-previews.ts",
    "catalog:verify": "tsx scripts/verify-catalog.ts",
    "catalog:worker:generate": "tsx scripts/generate-worker-catalog.ts",
    "catalog:worker:verify": "tsx scripts/generate-worker-catalog.ts --check",
    "verify:production-mcp": "tsx scripts/verify-production-mcp.ts",
    "check": "pnpm test && pnpm catalog:verify && pnpm catalog:worker:verify",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@designmcp/catalog": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.0.0",
    "playwright-core": "^1.55.0",
    "tsx": "4.23.12",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  }
}
