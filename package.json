{
  "name": "rendyn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @rendyn/api --filter @rendyn/preview dev",
    "dev:api": "pnpm --filter @rendyn/api dev",
    "dev:preview": "pnpm --filter @rendyn/preview dev",
    "start:api": "pnpm --filter @rendyn/api start",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "catalog:embed": "tsx scripts/embed-catalog.ts",
    "catalog:screenshots": "tsx scripts/capture-previews.ts && pnpm catalog:images",
    "catalog:verify": "tsx scripts/verify-catalog.ts",
    "catalog:worker:generate": "tsx scripts/generate-worker-catalog.ts",
    "catalog:worker:verify": "tsx scripts/generate-worker-catalog.ts --check",
    "cloudflare:build:web": "pnpm release:check && pnpm verify:web-config && pnpm --filter @rendyn/web build && pnpm verify:web-build",
    "cloudflare:deploy:web": "pnpm --filter @rendyn/web run deploy",
    "cloudflare:deploy:web:dry-run": "pnpm --filter @rendyn/web deploy:dry-run",
    "cloudflare:deploy:mcp": "pnpm --filter @rendyn/api deploy",
    "cloudflare:deploy:mcp:dry-run": "pnpm --filter @rendyn/api deploy:dry-run",
    "verify:production-mcp": "tsx scripts/verify-production-mcp.ts",
    "check": "pnpm test && pnpm catalog:verify && pnpm catalog:worker:verify && pnpm catalog:images:verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:images": "tsx scripts/optimise-preview-images.ts",
    "catalog:images:verify": "tsx scripts/verify-preview-images.ts",
    "release:check": "pnpm check && pnpm --filter @rendyn/web lint && pnpm test:worker",
    "verify:web-config": "tsx scripts/verify-release-config.ts",
    "verify:web-build": "tsx scripts/verify-built-web-config.ts",
    "test:worker": "node scripts/verify-worker-runtime.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/client": "2.0.0",
    "@rendyn/catalog": "workspace:*",
    "@types/node": "^26.0.0",
    "playwright-core": "^1.55.0",
    "sharp": "0.35.4",
    "tsx": "4.23.12",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  }
}
