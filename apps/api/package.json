{
  "name": "@rendyn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker:dev": "wrangler dev --config wrangler.jsonc",
    "worker:types": "wrangler types --config wrangler.jsonc worker-configuration.d.ts",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run --keep-vars",
    "deploy": "wrangler deploy --config wrangler.jsonc --keep-vars"
  },
  "dependencies": {
    "@rendyn/catalog": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@supabase/supabase-js": "2.112.4",
    "hono": "4.13.5",
    "jose": "6.2.10",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260901.1",
    "tsx": "4.23.12",
    "wrangler": "4.127.1"
  }
}
