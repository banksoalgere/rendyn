{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./vendor-root/*"]
    }
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "vendor-root/**/*.ts", "vendor-root/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
